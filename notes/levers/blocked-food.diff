+        {
+            sealedLogged++;
+            char buf[160];
+            std::snprintf(buf, sizeof buf, "LOG sealed-food r%d sealed=%d/%.3f reach=%d/%.3f comp=%d\n", round, sealed,
+                          sealedRate, reach, reachRate, static_cast<int>(q.size()));
+            out += buf;
+        }
+        return fire;
     }
 
